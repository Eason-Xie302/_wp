<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>𝕯𝖍𝖗𝖊𝖆𝖉𝖘</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: #000;
      color: #fff;
      min-height: 100vh;
    }
    .container {
      display: flex;
      max-width: 1200px;
      margin: 0 auto;
      min-height: 100vh;
    }
    .sidebar {
      width: 280px;
      padding: 20px;
      border-right: 1px solid #2e2e2e;
      position: sticky;
      top: 0;
      height: 100vh;
    }
    .sidebar h1 {
      font-size: 28px;
      margin-bottom: 30px;
      padding: 10px;
    }
    .nav-item {
      display: block;
      padding: 15px;
      color: #fff;
      text-decoration: none;
      font-size: 18px;
      border-radius: 30px;
      margin-bottom: 5px;
      transition: background 0.2s;
    }
    .nav-item:hover { background: #1a1a1a; }
    .nav-item.active { background: #1a1a1a; }
    .btn {
      display: inline-block;
      padding: 15px;
      color: #fff;
      text-decoration: none;
      font-size: 18px;
      border-radius: 30px;
      background: #000;
      border: none;
      cursor: pointer;
      width: 100%;
      text-align: left;
      margin-top: 20px;
    }
    .btn:hover { background: #1a1a1a; }
    .main {
      flex: 1;
      padding: 20px;
      max-width: 600px;
      border-right: 1px solid #2e2e2e;
    }
    .section-title {
      font-size: 24px;
      margin-bottom: 20px;
      padding-bottom: 15px;
      border-bottom: 1px solid #2e2e2e;
    }
    .post-card {
      background: #161616;
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .post-header {
      display: flex;
      align-items: center;
      margin-bottom: 15px;
    }
    .avatar {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      margin-right: 12px;
    }
    .username { font-weight: 600; }
    .username a {
      color: #fff;
      text-decoration: none;
    }
    .username a:hover { color: #667eea; }
    .post-time { color: #888; font-size: 14px; }
    .post-title {
      font-size: 18px;
      font-weight: 600;
      margin-bottom: 10px;
    }
    .post-content {
      color: #e0e0e0;
      line-height: 1.6;
      margin-bottom: 15px;
    }
    .post-actions {
      display: flex;
      gap: 20px;
      margin-top: 15px;
    }
    .action-btn {
      background: none;
      border: none;
      color: #888;
      cursor: pointer;
      font-size: 14px;
      text-decoration: none;
    }
    .action-btn:hover { color: #fff; }
    .new-post-btn {
      background: #fff;
      color: #000;
      border: none;
      padding: 15px 30px;
      border-radius: 30px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      margin-bottom: 20px;
      transition: transform 0.2s;
      text-decoration: none;
      display: block;
      text-align: center;
    }
    .new-post-btn:hover { transform: scale(1.02); }
    .empty-state {
      text-align: center;
      padding: 40px;
      color: #888;
    }
    .right-panel {
      width: 350px;
      padding: 20px;
      display: none;
    }
    @media (min-width: 1000px) {
      .right-panel { display: block; }
    }
    .profile-card {
      background: #161616;
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
    }
    .profile-header {
      text-align: center;
      margin-bottom: 20px;
    }
    .profile-avatar {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 32px;
      font-weight: bold;
      margin: 0 auto 15px;
    }
    .profile-name { font-size: 20px; font-weight: 600; }
    .profile-username { color: #888; margin-bottom: 15px; }
  </style>
</head>
<body>
  <div class="container">
    <div class="sidebar">
      <h1>𝕯𝖍𝖗𝖊𝖆𝖉𝖘</h1>
      <a href="/" class="nav-item active">🏠 公共貼文</a>
      <% if (loggedIn) { %>
        <a href="/my-posts" class="nav-item">👤 我的貼文</a>
        <a href="/new" class="nav-item">✏️ 發布貼文</a>
        <form action="/logout" method="GET" style="margin-top: auto;">
          <button type="submit" class="btn">🚪 登出</button>
        </form>
      <% } else { %>
        <a href="/login" class="nav-item">🔑 登入</a>
        <a href="/register" class="nav-item">📝 註冊</a>
      <% } %>
    </div>
    
    <div class="main">
      <h2 class="section-title">最新貼文</h2>
      <% if (posts.length === 0) { %>
        <div class="empty-state">
          <p>暫時沒有貼文</p>
          <% if (loggedIn) { %>
            <p>成為第一個發布貼文的人！</p>
          <% } %>
        </div>
      <% } else { %>
        <% posts.forEach(post => { %>
          <div class="post-card">
            <div class="post-header">
              <a href="/user/<%= post.author %>">
                <div class="avatar"><%= post.author ? post.author.charAt(0).toUpperCase() : '?' %></div>
              </a>
              <div>
                <div class="username"><a href="/user/<%= post.author %>">@<%= post.author || 'unknown' %></a></div>
                <div class="post-time"><%= new Date(post.created_at).toLocaleString('zh-TW') %></div>
              </div>
            </div>
            <% if (post.title) { %>
              <div class="post-title"><%= post.title %></div>
            <% } %>
            <div class="post-content"><%- post.content.substring(0, 200) %><%= post.content.length > 200 ? '...' : '' %></div>
            <div class="post-actions">
              <a href="/post/<%= post.id %>" class="action-btn">💬 閱讀更多</a>
            </div>
          </div>
        <% }) %>
      <% } %>
    </div>
    
    <div class="right-panel">
      <% if (loggedIn) { %>
        <a href="/new" class="new-post-btn">發布新貼文</a>
      <% } else { %>
        <div class="profile-card">
          <div class="profile-header">
            <div class="profile-avatar">?</div>
            <div class="profile-name">訪客</div>
            <div class="profile-username">登入以發布貼文</div>
          </div>
          <a href="/login" class="new-post-btn" style="background: #667eea; color: #fff;">登入</a>
        </div>
      <% } %>
      <div class="profile-card">
        <p style="color: #888; text-align: center;">© 2024 𝕯𝖍𝖗𝖊𝖆𝖉𝖘</p>
      </div>
    </div>
  </div>
</body>
</html>
